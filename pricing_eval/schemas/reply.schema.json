{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Replier reply candidates",
  "type": "object",
  "additionalProperties": false,
  "required": ["replies"],
  "properties": {
    "replies": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 400 } }
      }
    }
  }
}
